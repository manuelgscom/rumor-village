# Action grammar (es, notext). Generated by bench/grammar/make_grammar.sh; do not edit.
root ::= "{\"action\":" (say | go | none) "}"

# turn: say (greet, tell, ask, bye) or none; plan: go or none
say  ::= "\"say\",\"act\":" (greet | tell | ask | bye)
greet ::= "\"greet\""
bye  ::= "\"bye\""
ask  ::= "\"ask\",\"fact\":" fact
tell ::= "\"tell\",\"fact\":" fact ",\"claim\":" claim
go   ::= "\"go\",\"fact\":" fact ",\"claim\":" claim
none ::= "\"none\""

# number in the card list "Lo que sabes" (the engine checks that it exists)
fact ::= [1-9] [0-9]?

# every slot is present, null when omitted; guess lists the guessed slots
claim  ::= "{\"who\":" who ",\"where\":" where ",\"when\":" when ",\"amount\":" amount ",\"guess\":" guess "}"
who    ::= "null" | "\"" neighbor "\""
where  ::= "null" | "\"" place "\""
when   ::= "null" | "\"" day " " hour ":" ("00" | "30") "\""
day    ::= "hoy" | "mañana"
hour   ::= [01] [0-9] | "2" [0-3]
amount ::= "null" | "0" | [1-9] [0-9]{0,6}
guess  ::= "[]" | "[" slot ("," slot){0,3} "]"
slot   ::= "\"" ("who" | "where" | "when" | "amount") "\""

place    ::= ("ayuntamiento" | "bar" | "e" ("rmita" | "scuela") | "f" ("armacia" | "uente") | "iglesia" | "m" ("ercado" | "olino") | "p" ("anadería" | "laza") | "río")
neighbor ::= ("A" ("dela" | "l" ("berto" | "ejandro" | "fonso" | "icia") | "n" ("a" | "tonio") | "rturo") | "B" ("e" ("atriz" | "nito" | "rnardo") | "runo") | "C" ("ar" ("l" ("a" | "os") | "men" | "olina") | "elia" | "ristina") | "D" ("aniel" | "iego") | "E" ("duardo" | "l" ("ena" | "isa") | "milio" | "nrique" | "rnesto" | "st" ("eban" | "her") | "ugenia" | "va") | "F" ("e" ("lipe" | "rnando") | "rancisco") | "G" ("abriel" | "ema" | "onzalo" | "regorio" | "uillermo") | "Hugo" | "I" ("gnacio" | "nma" | "rene" | "s" ("abel" | "mael")) | "J" ("a" ("ime" | "vier") | "o" ("rge" | "sefa") | "u" ("an" ("a")? | "lia")) | "L" ("aura" | "e" ("andro" | "ticia") | "idia" | "o" ("la" | "ren" ("a" | "zo")) | "uis") | "M" ("a" ("ite" | "nuel" ("a")? | "r" ("cos" | "io" | "ta") | "teo") | "i" ("guel" | "la" | "riam") | "ontse") | "N" ("atalia" | "erea" | "oelia" | "uria") | "Olga" | "P" ("a" ("blo" | "tricia" | "ula") | "e" ("dro" | "pa")) | "R" ("a" ("fael" | "miro" | "quel") | "ebeca" | "icardo" | "o" ("berto" | "drigo")) | "S" ("a" ("muel" | "ntiago" | "ra") | "ergio" | "ilvia" | "onia" | "usana") | "T" ("amara" | "e" ("odoro" | "resa")) | "V" ("anesa" | "icente") | "Yolanda")
